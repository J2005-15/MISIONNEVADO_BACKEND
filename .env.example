# ─── Copia este archivo como .env y completa los valores ──────────────────────

# 'local' usa PostgreSQL local | 'remote' usa Neon
# (los scripts npm run dev:local / dev:remote lo sobrescriben)
DB_TARGET=local

# Base de Datos Local (PostgreSQL)
DB_HOST_LOCAL=localhost
DB_PORT_LOCAL=5432
DB_NAME_LOCAL=BD_SISVICR
DB_USER_LOCAL=postgres
DB_PASS_LOCAL=

# Base de Datos Remota (Neon) — cadena completa de conexión
DB_URI_REMOTE=postgresql://usuario:clave@host.neon.tech/neondb?sslmode=require
DB_NAME_REMOTE=neondb

# Servidor
PORT=3000
NODE_ENV=development
JWT_SECRET=

# Orígenes permitidos por CORS (separados por coma): dashboard, web pública
# En producción: las URLs reales, ej. https://panel.midominio.com,https://midominio.com
FRONTEND_URL=http://localhost:5173,http://localhost:5174

# Cloudinary — Almacenamiento de fotos de adopción
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# EmailJS — Correos automáticos (opcional: si queda vacío no se envían correos)
# En EmailJS: Account → Security → activar "Allow EmailJS API for non-browser applications"
EMAILJS_SERVICE_ID=
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=
# UNA sola plantilla para todos los avisos (docs/emailjs/plantilla-general.html).
# Variables: {{to_email}} {{to_name}} {{asunto}} {{etiqueta}} {{titulo}} {{{contenido}}}
#            {{boton_texto}} {{boton_url}} {{direccion}} {{telefono}}
EMAILJS_TEMPLATE_ID=

# URL de la web pública (para el enlace "Consultar mi solicitud" de los correos)
WEB_PUBLICA_URL=https://misionnevadoweb.netlify.app
